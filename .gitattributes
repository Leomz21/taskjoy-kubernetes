# Los archivos que se ejecutan dentro de contenedores Linux deben conservar
# finales de línea LF. Si Windows los convierte a CRLF, el contenedor falla
# con un error de "not found" al arrancar.
*.sh        text eol=lf
Dockerfile  text eol=lf
*.conf      text eol=lf
*.yaml      text eol=lf
*.yml       text eol=lf
